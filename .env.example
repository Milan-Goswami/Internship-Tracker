# ==============================================================================
# InternTrack — Environment Variable Configuration Template
# Copy this file to .env or export these variables in your deployment environment.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/interntrack_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Backend Server Configuration
PORT=8080

# Security Configuration (Required for Phase 3+)
# Must be a cryptographically secure 512-bit string for HMAC-SHA512
JWT_SECRET_KEY=replace_with_a_secure_512_bit_random_secret_key_for_production